server {
 listen 80;
 if ($http_x_streaming_origin != "${ORIGIN_VERIFY_SECRET}") { return 403; }
 location / { root /usr/share/nginx/html; try_files $uri /index.html; }
 location /api/ { proxy_pass http://${API_UPSTREAM}; proxy_set_header Host $host; }
 location /media/ { return 404; }
 location /videos/ { return 404; }
 location /dev/ { return 404; }
 location /internal/ { return 404; }
 location /actuator/ { return 404; }
}
