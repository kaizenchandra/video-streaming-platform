        "summary": "GET /videos/{id}/erasure-status",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "string",
                      "enum": [
                        "PENDING",
                        "DONE"
                      ]
                    },
                    "not_before": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "attempts": {
                      "type": "integer"
                    },
                    "last_error": {
                      "type": "string",
                      "nullable": true
                    },
                    "completed_at": {
                      "type": "string",
                      "format": "date-time",
                      "nullable": true
                    },
                    "legalHold": {
                      "type": "boolean"
                    },
                    "scratchPending": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 0,
                      "description": "Tracked attempts without a local purge receipt; includes active/held attempts."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "JWT required"
          },
          "403": {
            "description": "Owner or trusted moderator role required"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Stale version, duplicate handle, or invalid state"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "description": "Owner-readable primary-bucket erasure status after deletion. scratchPending counts tracked local attempts only; DONE does not imply scratch, backups, replicas, CDN or physical disk sanitization."
      }
    },
