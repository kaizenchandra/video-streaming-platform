  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Metadata": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "category": {
            "type": "string"
          },
          "tags": {
            "type": "string"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "UNLISTED",
              "PRIVATE"
            ]
          },
          "published": {
            "type": "boolean"
          }
        },
        "required": [
          "title",
          "category",
          "visibility"
        ],
        "additionalProperties": false
      },
      "UploadStart": {
        "type": "object",
        "properties": {
          "videoId": {
            "type": "string",
            "format": "uuid"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 21474836480
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "videoId",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false
      },
      "Parts": {
        "type": "object",
        "properties": {
          "first": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "first",
          "count"
        ],
        "additionalProperties": false
      },
      "Progress": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "position": {
            "type": "number",
            "minimum": 0
          },
          "completed": {
            "type": "boolean"
          }
        },
        "required": [
          "sessionId",
          "sequence",
          "position"
        ],
        "additionalProperties": false
      },
      "Comment": {
        "type": "object",
        "properties": {
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "body"
        ],
        "additionalProperties": false
      },
      "Preferences": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
          },
          "theme": {
            "type": "string",
            "enum": [
              "dark",
              "light",
              "system"
            ]
          },
          "autoplay": {
            "type": "boolean"
          }
        },
        "required": [
          "language",
          "theme"
        ],
        "additionalProperties": false
      },
      "Profile": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "preferences": {
            "$ref": "#/components/schemas/Preferences"
          }
        },
        "required": [
          "displayName",
          "preferences"
        ],
        "additionalProperties": false
      },
      "Channel": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{2,39}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "handle",
          "name",
          "description"
        ],
        "additionalProperties": false
      },
      "ModerationDecision": {
        "type": "object",
        "properties": {
          "attempt": {
            "type": "string",
            "format": "uuid"
          },
          "decision": {
            "type": "string",
            "enum": [
              "APPROVED",
              "REJECTED"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "attempt",
          "decision",
          "reason"
        ],
        "additionalProperties": false
      },
      "LegalHold": {
        "type": "object",
        "properties": {
          "held": {
            "type": "boolean"
          }
        },
        "required": [
          "held"
        ],
        "additionalProperties": false
      }
    }
  }
}
